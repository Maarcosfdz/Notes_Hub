---
const { subject, active } = Astro.props;
const root = import.meta.env.BASE_URL;
const tools = subject === "aws" ? [
  { label: "Apuntes", kind:'notes', href: `${root}materias/aws/apuntes/`, match: active === "notes" },
  { label: "Conceptos", kind:'concepts', href: `${root}materias/aws/terminos/`, match: active === "concepts" },
  { label: "Preguntas", kind:'questions', href: `${root}materias/aws/preguntas/`, match: active === "questions" },
] : [];
---
{tools.length > 0 && <nav class="study-nav" aria-label="Herramientas de estudio de AWS">
  <span class="study-nav-label">Estudia AWS</span>
  {tools.map((tool) => <a href={tool.href} data-kind={tool.kind} aria-current={tool.match ? "page" : undefined}>{tool.label}</a>)}
</nav>}
