---
import "../styles/global.css";
const { title = "Biblioteca", description = "Apuntes, conceptos y recursos organizados por áreas y materias." } = Astro.props;
const root = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f2eb" />
    <title>{title} · Notes Hub</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <a class="wordmark" href={root} aria-label="Notes Hub, inicio">
        <span class="mark" aria-hidden="true">n.</span><span>Notes Hub<span class="wordmark-soft">/</span></span>
      </a>
      <nav class="desktop-nav" aria-label="Navegación principal">
        <a href={root} aria-current={path === root ? "page" : undefined}>Biblioteca</a>
        <a href={`${root}buscar/`} aria-current={path.includes("/buscar/") ? "page" : undefined}>Buscar</a>
        <a href={`${root}como-aportar/`}>Guía</a>
      </nav>
      <details class="mobile-menu"><summary>Menú</summary><nav aria-label="Navegación móvil"><a href={root}>Biblioteca</a><a href={`${root}buscar/`}>Buscar</a><a href={`${root}como-aportar/`}>Guía</a></nav></details>
      <div class="header-actions">
        {Astro.locals.user && <button class="action-button" type="button" data-logout>Salir</button>}
        <a class="header-search" href={`${root}buscar/`} aria-label="Buscar apuntes">
          <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10.8" cy="10.8" r="6.5"/><path d="m16 16 4.3 4.3"/></svg>
          <span class="search-label">Buscar apuntes</span>
        </a>
        <button class="theme-toggle" type="button" aria-label="Cambiar a tema oscuro" data-theme-toggle>
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.3 15.1A8.4 8.4 0 0 1 8.9 3.7 8.5 8.5 0 1 0 20.3 15.1Z"/></svg>
          <span class="theme-label">Tema</span>
        </button>
      </div>
    </header>
    <main id="contenido" tabindex="-1"><slot /><p class="operation-status" role="status" aria-live="polite" aria-atomic="true" data-persistence-status></p></main>
    <footer><span>Un espacio personal para aprender con calma.</span><a href={root}>Volver a la biblioteca ↑</a></footer>
    <script>
      import {enhanceContent} from '../scripts/content-accessibility';
      enhanceContent();
      const mobile=document.querySelector<HTMLDetailsElement>('.mobile-menu');
      mobile?.addEventListener('keydown',event=>{if(event.key==='Escape'){mobile.open=false;mobile.querySelector('summary')?.focus();}});
      document.querySelector<HTMLButtonElement>("[data-logout]")?.addEventListener("click",async(event)=>{
        const button=event.currentTarget as HTMLButtonElement;button.disabled=true;
        try{const response=await fetch("/api/auth/sign-out",{method:"POST",headers:{"Content-Type":"application/json"},body:"{}"});if(!response.ok)throw Error('No se pudo cerrar la sesión. Reintenta.');location.assign("/login");}
        catch{document.querySelector<HTMLElement>('[data-persistence-status]')!.textContent='No se pudo cerrar la sesión. Comprueba la conexión y reintenta.';button.disabled=false;}
      });
      const toggle = document.querySelector("[data-theme-toggle]");
      let storedTheme:string|null=null;try{storedTheme=localStorage.getItem("studyTheme");}catch{/* Theme remains usable when storage is unavailable. */}
      const applyTheme = (theme: "dark" | "light") => {
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", theme === "dark" ? "#191d1a" : "#f5f2eb");
        toggle?.setAttribute("aria-label", theme === "dark" ? "Cambiar a tema claro" : "Cambiar a tema oscuro");
      };
      applyTheme(storedTheme === "dark" ? "dark" : "light");
      toggle?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        applyTheme(next);
        try{localStorage.setItem("studyTheme", next);}catch{/* Theme still applies for this page. */}
      });
    </script>
  </body>
</html>
