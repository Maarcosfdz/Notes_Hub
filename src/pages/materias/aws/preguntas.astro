---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import StudyTools from "../../../components/StudyTools.astro";
import QuizFilters from "../../../components/QuizFilters.astro";
import bank from "../../../content/modules/devops/aws/questions/bank.json";
const root = import.meta.env.BASE_URL;
const levels = [...new Set(bank.map((question) => question.level))].sort((a, b) => a.localeCompare(b, "es"));
---
<BaseLayout title="Preguntas AWS" description="Practica AWS con preguntas por tema y nivel.">
  <div class="breadcrumb"><a href={root}>Biblioteca</a> / <a href={`${root}materias/aws/`}>AWS</a> / Preguntas</div>
  <section class="page-intro reveal"><span class="eyebrow">Estudio activo / AWS</span><h1>Practica y recuerda.</h1><p class="lead">{bank.length} preguntas con explicaciones. Filtra por tema y nivel, o vuelve a las que fallaste.</p><StudyTools subject="aws" active="questions" /></section>
  <QuizFilters levels={levels}/>
  <section id="quiz" class="question-card" aria-live="polite" aria-atomic="true"></section>
  <script>
    import {initializeQuiz} from "../../../scripts/quiz-controller";
    import {showError} from "../../../scripts/progress";
    void initializeQuiz().catch(showError);
  </script>
</BaseLayout>
