{
  "name": "notes-hub",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24.14.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs dev",
    "build": "astro check && astro build",
